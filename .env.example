# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: AI model for Robin chatbot (defaults to gemini-3.6-flash)
GEMINI_MODEL="gemini-3.6-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Email notifications (Nodemailer via Gmail SMTP: smtp.gmail.com)
# What you need for Gmail:
# 1. Your Gmail address (SMTP_USER or GMAIL_USER)
# 2. A 16-character Google App Password (SMTP_PASS or GMAIL_APP_PASSWORD)
#    Generated at: https://myaccount.google.com/apppasswords (requires 2-Step Verification)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""

# Fallback aliases for GMAIL_USER / GMAIL_APP_PASSWORD
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Destination email for quote alert notifications (default: addgardens1@gmail.com)
NOTIFICATION_EMAIL="addgardens1@gmail.com"

# Optional admin access code for viewing lead transcripts (defaults to 'addgardens2026')
ADMIN_ACCESS_CODE="addgardens2026"

